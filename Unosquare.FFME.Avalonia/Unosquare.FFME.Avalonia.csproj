    <RootNamespace>Unosquare.FFME</RootNamespace>
    <AssemblyName>ffme.avalonia</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
