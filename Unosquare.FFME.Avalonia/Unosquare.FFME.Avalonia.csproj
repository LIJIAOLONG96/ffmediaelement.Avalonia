<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Unosquare.FFME</RootNamespace>
    <AssemblyName>ffme.avalonia</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <PackageId>FFME.Avalonia</PackageId>
    <Version>0.1.0-beta.1</Version>
    <Authors>LIJIAOLONG96 and FFME contributors</Authors>
    <Title>FFME for Avalonia</Title>
    <Description>A cross-platform Avalonia MediaElement powered by FFmpeg, with software video rendering, subtitles, and PortAudio output.</Description>
    <PackageTags>avalonia ffmpeg mediaelement audio video playback subtitles</PackageTags>
    <PackageProjectUrl>https://github.com/LIJIAOLONG96/ffmediaelement.Avalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LIJIAOLONG96/ffmediaelement.Avalonia.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.8" />
    <PackageReference Include="FFmpeg.AutoGen" Version="7.0.0" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.linux-aarch64" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.linux-x64" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-arm64" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-x64" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.win-x64" Version="1.0.6" />
    <PackageReference Include="org.portaudio.runtime.win-arm64" Version="19.7.5" />
  </ItemGroup>

  <Import Project="..\Unosquare.FFME.MediaElement\Unosquare.FFME.MediaElement.projitems" Label="Shared" />
  <Import Project="..\Unosquare.FFME\Unosquare.FFME.projitems" Label="Shared" />
</Project>